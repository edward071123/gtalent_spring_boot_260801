# Database
DB_URL=jdbc:mysql://localhost:3306/gtalent?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Taipei
DB_PORT=3306
DB_NAME=gtalent
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Test database
TEST_DB_URL=jdbc:mysql://localhost:3306/gtalent_test?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Taipei
TEST_DB_PORT=3306
TEST_DB_NAME=gtalent_test
TEST_DB_USERNAME=your_test_db_username
TEST_DB_PASSWORD=your_test_db_password

# Gmail SMTP
GMAIL_USERNAME=your_gmail_address
GMAIL_PASSWORD=your_gmail_app_password

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_SECONDS=3600
JWT_REFRESH_TOKEN_SECONDS=604800

# App
APP_BASE_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_MINUTES=30

# NewebPay
NEWEBPAY_MERCHANT_ID=your_newebpay_merchant_id
NEWEBPAY_HASH_KEY=your_newebpay_hash_key
NEWEBPAY_HASH_IV=your_newebpay_hash_iv
NEWEBPAY_VERSION=2.0
NEWEBPAY_GATEWAY_URL=https://ccore.newebpay.com/MPG/mpg_gateway
NEWEBPAY_NOTIFY_URL=http://localhost:8080/payments/newebpay/notify
NEWEBPAY_RETURN_URL=http://localhost:8080/payments/newebpay/return

# LINE Messaging API / Webhook
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
